{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boba-cat",
  "version": "2.2.0",
  "identifier": "io.github.lyova24.bobacat",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "boba-cat",
        "width": 128,
        "height": 128,
        "resizable": true,
        "fullscreen": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A tiny desktop cat enjoying some boba",
    "longDescription": "A tiny always-on-top desktop cat that reacts when you work in an IDE.",
    "homepage": "https://github.com/lyova24/boba-cat",
    "copyright": "Copyright © 2026 lyova24",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
